{
  "Next3": {
    "Mode": "fake",
    "BaseUrl": "https://PLACEHOLDER-next3.example",
    // apikey | oauth (#1). Validated only when Mode = real, because every value here is a
    // placeholder and an always-on validator would stop the app booting (slice 3.3).
    "AuthMode": "PLACEHOLDER",
    "ApiKey": "PLACEHOLDER-next3-api-key",
    "OAuth": {
      "TokenUrl": "https://PLACEHOLDER-next3.example/auth/token",
      "ClientId": "PLACEHOLDER-client-id",
      "ClientSecret": "PLACEHOLDER-client-secret"
    },
    // (#1) mTLS is config-ready and deliberately not exercised — design.md §6.1, slice 3.3.
    "ClientCertificatePath": "PLACEHOLDER-client-certificate-path",
    // A real deadline, so a hung NEXT3 lands on §6.3's retry schedule instead of holding its lease.
    "TimeoutSeconds": 30,
    "DocTypes": {
      "InsuredDocument": "PLACEHOLDER-DOC-01",
      "InsuredCarPhoto": "PLACEHOLDER-DOC-02",
      "TpDocument": "PLACEHOLDER-DOC-03",
      "TpCarPhoto": "PLACEHOLDER-DOC-04",
      "ExpertReport": "PLACEHOLDER-DOC-05",
      "VoiceNote": "PLACEHOLDER-DOC-06",
      "DamageDiagram": "PLACEHOLDER-DOC-07",
      "ApprovalImage": "PLACEHOLDER-DOC-08",
      "RepairPhoto": "PLACEHOLDER-DOC-09",
      "Discharge": "PLACEHOLDER-DOC-10",
      "Invoice": "PLACEHOLDER-DOC-11",
      "SurveyDocument": "PLACEHOLDER-DOC-12",
      "GarageCarPhoto": "PLACEHOLDER-DOC-13"
    },
    "ArrivalFieldMap": "PLACEHOLDER",
    "ArrivalTimeZone": "PLACEHOLDER-IANA-ZONE",
    "AssignmentSource": "fake"
  },
  // Bound to BrokerOptions and validated at startup in every environment (slice 5.2): the type list
  // must be non-empty, every type must have a routing entry and every recipient must parse. These
  // placeholders pass; a mistyped type fails the boot rather than the first broker.
  "Broker": {
    // The BRD's Option 1 kill-switch. False removes B2's file control (GET /api/config/media
    // projects the effective value) and refuses an `uploaded` origin on the broker bucket.
    "AllowUpload": true,
    "InsuranceTypes": [
      "MOTOR ALL RISK",
      "MOTOR TOTAL LOSS",
      "PLACEHOLDER-TYPE-3"
    ],
    "EmailRouting": {
      "MOTOR ALL RISK": "PLACEHOLDER-recipient-1@example.invalid",
      "MOTOR TOTAL LOSS": "PLACEHOLDER-recipient-2@example.invalid",
      "PLACEHOLDER-TYPE-3": "PLACEHOLDER-recipient-3@example.invalid"
    }
  },
  "PublicLink": {
    "ValidityDays": 7,
    "DeliveryChannel": "copy",
    "MaxFiles": 15,
    "MaxFileMb": 10,
    "RateLimit": {
      "PerIpPermitsPerMinute": 60,
      "PerTokenPermitsPerMinute": 60
    }
  },
  "Clarity": {                               // (#9); served to the browser by GET /api/config/media
    "MinWidth": 1024,
    "MinHeight": 768,
    "BlurVarianceThreshold": 100,
    "BlurAnalysisMaxEdge": 512               // the scale the threshold above is measured at (slice 2.5)
  },
  "Auth": {
    "OtpTtlMinutes": 5,
    "OtpMaxAttempts": 5,
    "OtpResendSeconds": 60,
    "InviteValidityDays": 7,
    // Where the web app is served from, for the invitation link in the onboarding SMS (S1).
    // Deployment config, overridden by Auth__AppBaseUrl — and deliberately NOT derived from the
    // request host, which is attacker-controlled and would poison a link carrying a live credential.
    "AppBaseUrl": "https://PLACEHOLDER-app.example",
    "Jwt": {
      "Issuer": "PLACEHOLDER-axa-motor-claims",
      "Audience": "PLACEHOLDER-axa-motor-claims",
      "SigningKey": "PLACEHOLDER-dev-only-signing-key-0000000000000000",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14
    },
    "SeedAdmin": {
      "Phone": "+999000000001",
      "DisplayName": "PLACEHOLDER Admin"
    }
  },
  "Blob": {
    "Mode": "fake",
    "ContainerName": "media-transit"
  },
  // §8's push rows (realized 2026-08-21, slice 3.4). Same shape as Blob:Mode and Next3:Mode.
  "Push": {
    "Mode": "fake",                          // fake | webpush
    "Vapid": {
      // A VAPID private key is a real credential — anyone holding it can send notifications that
      // browsers accept as coming from AXA. These stay PLACEHOLDER for ever; real keys live in
      // `dotnet user-secrets` locally and Container Apps secrets in deployment (see CLAUDE.md).
      // Generate a pair with: npx --yes web-push generate-vapid-keys
      "Subject": "mailto:PLACEHOLDER-push-contact@example.invalid",
      "PublicKey": "PLACEHOLDER-vapid-public-key",
      "PrivateKey": "PLACEHOLDER-vapid-private-key"
    },
    "TimeoutSeconds": 15,
    // Real values, not placeholders: these are the browsers' own push services, not client data —
    // the same treatment as Media:ImageContentTypes. An SSRF control, because the endpoint the
    // browser registers is a URL this API later POSTs to. Empty disables the check.
    "AllowedEndpointHosts": [
      "fcm.googleapis.com",
      "android.googleapis.com",
      "updates.push.services.mozilla.com",
      "notify.windows.com",
      "push.apple.com"
    ],
    "MaxSubscriptionsPerUser": 10
  },
  "Media": {
    "MaxFileMb": 15,
    "ImageContentTypes": [
      "image/jpeg",
      "image/png"
    ],
    "DocumentContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ],
    "AudioContentTypes": [                   // (#10) slice 3.1; the recorder picks from this list
      "audio/webm",
      "audio/mp4",
      "audio/ogg"
    ]
  },
  "Retention": {
    "BlobDays": 7,
    "BrokerBlobDays": 30,
    "OrphanBlobHours": 24,
    "OtpChallengeHours": 24,
    "CleanupEnabled": true,
    "PollMinutes": 60
  },
  "Outbox": {
    "MaxAttempts": 8,
    "BackoffCeilingHours": 6,
    "BatchSize": 10,
    "PollSeconds": 30,
    "LeaseSeconds": 300,
    "WorkerEnabled": true
  },
  "Fake": {
    "FailureRate": 0.0,
    "LatencyMs": 0
  }
}
