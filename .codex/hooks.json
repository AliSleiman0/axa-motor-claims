{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File 'C:\\dev\\axa-motor-claims\\.codex\\hooks\\post-edit.ps1'",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File 'C:\\dev\\axa-motor-claims\\.codex\\hooks\\on-stop.ps1'",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
